meta {
  name: Changes advertisement
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/advertisement/:advertisement-id
  body: json
  auth: none
}

params:path {
  advertisement-id: {{ad1_id}}
}

body:json {
  {
    "title": "lammel"
  }
}

assert {
  res.status: eq 200
  : 
}

script:pre-request {
  // retrieve the cookie string you stored earlier
  const cookie = bru.getVar("cookie_user1");
  
  if (cookie) {
    // set it as the Cookie header on the outgoing request
    req.setHeader("Cookie", cookie);
  }
}
